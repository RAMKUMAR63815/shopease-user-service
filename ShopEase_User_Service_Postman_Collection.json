
{
  "info": {
    "name": "ShopEase User Service - Complete API Tests",
    "description": "Postman collection for testing ShopEase User Management Service: health, JWT authentication, profile CRUD, address CRUD, partial updates, default address and deactivation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8012"
    },
    {
      "key": "token",
      "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI0Iiwicm9sZSI6IkNVU1RPTUVSIiwiaWF0IjoxNzk0Mzg2MTA1LCJleHAiOjE3OTQzODc5MDV9.bGlIXnDUb2lCOxxc7820gMBNlPlWkcag9F3aWbhtWeY"
    },
    {
      "key": "address_id",
      "value": "4"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health check returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Service is healthy', function () { pm.expect(pm.response.json().status).to.eql('healthy'); });",
                  "pm.test('Correct service name', function () { pm.expect(pm.response.json().service).to.eql('user-management'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Authentication Tests",
      "item": [
        {
          "name": "Missing JWT - Expect 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/users/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing token returns 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid JWT - Expect 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer invalid.test.token"
              }
            ],
            "url": "{{base_url}}/api/users/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid token returns 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. User Profile Management",
      "item": [
        {
          "name": "Create Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Test Customer\",\n  \"phone_number\": \"+919876543210\",\n  \"date_of_birth\": \"2000-01-15\",\n  \"gender\": \"MALE\"\n}"
            },
            "url": "{{base_url}}/api/users/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile creation returns 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Profile response is JSON', function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/users/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get profile returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Profile response is JSON', function () { pm.response.to.be.json; });",
                  "pm.test('Profile has an ID', function () { pm.expect(pm.response.json().id).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Updated Test Customer\",\n  \"phone_number\": \"+919876543210\",\n  \"date_of_birth\": \"2000-01-15\",\n  \"gender\": \"MALE\"\n}"
            },
            "url": "{{base_url}}/api/users/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile update returns 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Partially Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Updated Customer Name\"\n}"
            },
            "url": "{{base_url}}/api/users/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile partial update returns 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. User Address Management",
      "item": [
        {
          "name": "Create Address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address_type\": \"HOME\",\n  \"full_name\": \"Test Customer\",\n  \"phone_number\": \"+919876543210\",\n  \"address_line_1\": \"12 Main Road\",\n  \"address_line_2\": \"Near Bus Stand\",\n  \"city\": \"Chennai\",\n  \"state\": \"Tamil Nadu\",\n  \"country\": \"India\",\n  \"postal_code\": \"600001\",\n  \"is_default\": true\n}"
            },
            "url": "{{base_url}}/api/users/addresses"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Address creation returns 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Address response is JSON', function () { pm.response.to.be.json; });",
                  "let data = pm.response.json();",
                  "pm.test('Address ID is returned', function () { pm.expect(data.id).to.exist; });",
                  "if (data.id) { pm.collectionVariables.set('address_id', data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All My Addresses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/users/addresses"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get all addresses returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Address list response is JSON', function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Address By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/users/addresses/{{address_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get address by ID returns 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Address - PUT",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address_type\": \"HOME\",\n  \"full_name\": \"Test Customer\",\n  \"phone_number\": \"+919876543210\",\n  \"address_line_1\": \"25 Updated Main Road\",\n  \"address_line_2\": \"Near Bus Stand\",\n  \"city\": \"Chennai\",\n  \"state\": \"Tamil Nadu\",\n  \"country\": \"India\",\n  \"postal_code\": \"600001\",\n  \"is_default\": true\n}"
            },
            "url": "{{base_url}}/api/users/addresses/{{address_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Address PUT returns 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Partially Update Address - PATCH",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"Chennai\"\n}"
            },
            "url": "{{base_url}}/api/users/addresses/{{address_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Address PATCH returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Updated city is Chennai', function () { pm.expect(pm.response.json().city).to.eql('Chennai'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Set Address As Default",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/users/addresses/{{address_id}}/default"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Set default address returns 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Address",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/users/addresses/{{address_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Address delete returns 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Profile Deactivation - Run Separately at End",
      "item": [
        {
          "name": "Deactivate My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/users/profile/deactivate"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile deactivation returns 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Profile Delete - Alternative Cleanup",
      "description": "Run this instead of profile deactivation, not after it. This operation may remove the profile.",
      "item": [
        {
          "name": "Delete My Profile",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/users/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile delete returns 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
