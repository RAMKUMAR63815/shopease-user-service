
{
  "info": {
    "name": "ShopEase User Service - Postman Collection",
    "description": "API testing collection for ShopEase User Management Microservice. Includes profile CRUD, address CRUD, partial updates, default address, JWT authentication and automated response checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8012"
    },
    {
      "key": "token",
      "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI0Iiwicm9sZSI6IkNVU1RPTUVSIiwiaWF0IjoxNzk0Mzg2MTA1LCJleHAiOjE3OTQzODc5MDV9.bGlIXnDUb2lCOxxc7820gMBNlPlWkcag9F3aWbhtWeY"
    },
    {
      "key": "profile_id",
      "value": ""
    },
    {
      "key": "address_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "item": [
        {
          "name": "Check User Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health check returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Service status is healthy', function () { pm.expect(pm.response.json().status).to.eql('healthy'); });",
                  "pm.test('Correct service name', function () { pm.expect(pm.response.json().service).to.eql('user-management'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Authentication Tests",
      "item": [
        {
          "name": "Get Profile Without Token - Expected 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/users/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing token is rejected with 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Profile With Valid JWT",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/users/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authenticated request is accepted', function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });",
                  "pm.test('Response is valid JSON', function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. User Profile Management",
      "item": [
        {
          "name": "Create User Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Test Customer\",\n  \"phone_number\": \"+919876543210\",\n  \"date_of_birth\": \"2000-01-15\",\n  \"gender\": \"MALE\"\n}"
            },
            "url": "{{base_url}}/api/users/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile created successfully', function () { pm.response.to.have.status(201); });",
                  "pm.test('Profile response is JSON', function () { pm.response.to.be.json; });",
                  "let data = pm.response.json();",
                  "if (data.id) { pm.collectionVariables.set('profile_id', data.id); }",
                  "pm.test('Profile ID is returned', function () { pm.expect(data.id).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/users/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get profile returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Profile response is JSON', function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
        {
